# Neon Postgres — pooled connection string from the 4irecords-site project.
DATABASE_URL=

# Password for /admin. Required in production; if unset in dev, /admin
# is open on this machine only.
ADMIN_PASSWORD=

# Resend API key. Without it the site still works, but gated downloads
# can't be delivered and inquiry notifications aren't sent.
RESEND_API_KEY=
EMAIL_FROM="4i Records <hello@4irecords.com>"
EMAIL_NOTIFY=info@4irecords.com

# Absolute site URL, used to build download and unsubscribe links.
SITE_URL=https://www.4irecords.com

# Signs gated download links. Set this explicitly — without it the
# links are derived from ADMIN_PASSWORD, so rotating that password
# would invalidate every link already emailed out.
DOWNLOAD_SECRET=

# 4i Productions, once it's live. Unset means the visuals hand-off
# collects details on this site instead of linking out.
NEXT_PUBLIC_PRODUCTIONS_URL=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
